generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Visibility {
  PUBLIC
  FAMILY
  PRIVATE
}
enum UserRole {
  FAMILY_ADMIN
  CONTRIBUTOR
}
enum MemoryType {
  VOICE
  VIDEO
  PHOTO
  TEXT
}
enum MemorySource {  // all design-doc values kept; WEB_UPLOAD from /share; EMAIL / SMS / OTHER from admin drafts (draft-memory.ts)
  PHONE_CALL
  SMS
  WEB_UPLOAD
  EMAIL
  OTHER
}
enum MemoryStatus {
  DRAFT                                   // saved by the family admin on someone's behalf; invisible and silent until they press Share
  PENDING
  APPROVED
  HIDDEN
}
enum AnalysisStatus {
  NOT_STARTED
  QUEUED
  DONE
  FAILED
}
enum ChangedVia {
  WEB
  SMS
  CLAIM_LINK
  ADMIN
}
enum DerivedKind {
  WEB_IMAGE // 2048 px long edge, same container family as the original; what inline pages show
  THUMBNAIL // 1000 px long edge JPEG ≤ 350 KB on #fffdf8; what emails attach inline
  POSTER    // reserved: video poster from a browser-captured staging upload (email plan § 3.4)
}

enum DerivedStatus {
  PENDING // claimed by a worker; stale after 10 min
  READY
  FAILED  // error holds too_many_pixels:<limit> | decode_failed | timeout | too_large | unsupported_type
}

enum MediaStatus {
  PENDING
  READY
  FAILED
}
enum EmailType {
  MEMORY_CONFIRMATION
  ADMIN_NEW_MEMORY                        // family admins: "a new memory landed" (Task 14)
  SUBMISSION_CONFIRMATION                 // one receipt for a whole send of several memories, logged on the anchor (Task 15)
}
enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}
model Memorial {
  id                String      @id @default(uuid())
  name              String
  slug              String      @unique
  born              DateTime?   @db.Date
  died              DateTime?   @db.Date
  defaultVisibility Visibility  @default(FAMILY)
  createdAt         DateTime    @default(now())
  contributors      Contributor[]
  memories          Memory[]
  people            Person[]
}

model User {                              // Phase 3 fills this in (magic-link login) [C1]
  id          String   @id @default(uuid())
  email       String?  @unique
  phone       String?  @unique
  role        UserRole @default(CONTRIBUTOR)
  createdAt   DateTime @default(now())
  contributor Contributor?
  revisions   MemoryRevision[]
}

model Contributor {                       // one row per submission in Phase 1; merging by verified email is Phase 3
  id            String    @id @default(uuid())
  memorialId    String
  userId        String?   @unique
  name          String?
  phone         String?                    // column kept for the design doc; not collected by the Phase 1 form
  email         String?                    // unverified; used only to send the confirmation
  relationship  String?
  contactOptIn  Boolean   @default(false)  // the OPTIONAL "you may contact me" checkbox, not the storage consent
  mailingListOptIn Boolean @default(false) // "sign up for our weekly mailing list" checkbox; off by default (Rob, 2026-11-03)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  memorial      Memorial  @relation(fields: [memorialId], references: [id])
  user          User?     @relation(fields: [userId], references: [id])
  memories      Memory[]
  @@index([memorialId, email])
}

model Memory {
  id              String         @id @default(uuid())
  memorialId      String
  contributorId   String?
  type            MemoryType
  source          MemorySource
  sourceRef       String?        @unique     // opaque, unique reference to where the words came from; never an address or number in clear (lib/validations/memory.ts)
  approxDateText  String?        // as given: "Summer 1998"
  approxYear      Int?
  approxMonth     Int?
  place           String?
  latitude        Float?         // WGS 84, a named place's point (never a house, never a photo's GPS); set through /api/mcp and the admin draft API; shown on See memories only rounded to 0.05° and only for APPROVED + PUBLIC memories (plan 2026-11-08 D2)
  longitude       Float?         // WGS 84, a named place's point (never a house, never a photo's GPS); set through /api/mcp and the admin draft API; shown on See memories only rounded to 0.05° and only for APPROVED + PUBLIC memories (plan 2026-11-08 D2)
  tags            String[]       @default([])  // "patches": normalised by lib/memories/tags.ts (≤20, ≤40 characters, one spelling per slug); edited through update_memory and the admin edit form (plan 2026-11-08 D3)
  contributorNote String?        // the person's words: as typed on /share, or an admin-drafted excerpt (verbatim, or a light rewrite the sender edits before Share; the verbatim text is in the ADMIN revision's before)
  language        String         @default("en")
  visibility      Visibility     @default(FAMILY)
  notifyWhenPosted Boolean       @default(true)  // "let me know when my story is posted" checkbox; on by default (Rob, 2026-11-03)
  consentVersion  String                     // provisional while status = DRAFT (the version in force when drafted); restamped by Share
  consentedAt     DateTime?      // null only while status = DRAFT (CHECK constraint Memory_consent_when_not_draft); stamped when the person presses Share
  status          MemoryStatus   @default(PENDING)
  analysisStatus  AnalysisStatus @default(NOT_STARTED)
  claimTokenHash  String         @unique     // sha256 of the 32-byte base64url token; the raw token is never stored [C1]
  submissionId    String?                    // memories sent together from /share share one id; legacy rows are NULL (Task 15)
  submissionIndex Int?                       // 0..N-1 within the send; 0 is the anchor that carries the lease and the email row
  uploadLeaseUntil DateTime?                 // submission lease on the anchor (index 0; legacy rows carry their own): while live, the cron must not email or rotate
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  memorial        Memorial       @relation(fields: [memorialId], references: [id])
  contributor     Contributor?   @relation(fields: [contributorId], references: [id])
  media           Media[]
  revisions       MemoryRevision[]
  emails          EmailLog[]
  @@index([memorialId, status, createdAt])
  @@index([contributorId])
  @@index([createdAt])                       // daily budget count
  @@index([submissionId, submissionIndex])   // not @@unique: nullable columns; uniqueness holds by construction (one transaction assigns 0..N-1)
}

model Media {
  id               String      @id @default(uuid())
  memoryId         String
  storageKey       String      @unique      // Blob pathname: <env prefix><memoryId>/<uuid>.<ext> (originals/, preview/originals/, dev/originals/); write-once [C1, C9]
  blobUrl          String?                  // set from head() at READY; served only through /api/media/[id]
  status           MediaStatus @default(PENDING)
  originalFilename String?
  checksumSha256   String?                  // null until the background hash or the cron runs
  declaredSha256   String?                  // the SHA-256 a connector upload declared (request_upload); set exactly on addedVia = ADMIN rows (CHECKs Media_declared_sha256_hex, Media_admin_declared_sha256); checksumSha256 stays the verified hash and always wins
  addedVia         ChangedVia?              // null for site uploads (claim page, /share); ADMIN for a file attached through the MCP connector: recordMedia then requires the exact declared size, hashes before READY (up to INLINE_HASH_MAX_BYTES) and writes an ADMIN revision
  mimeType         String                   // normalized, no parameters (lib/media-types.ts)
  maxBytes         Int                      // ticketed limit; summed for the daily byte budget
  sizeBytes        Int?
  durationSeconds  Int?
  width            Int?
  height           Int?
  capturedAt       DateTime?                // from EXIF when present
  exif             Json?
  caption          String?                  // per-file words from the contributor (max 2000); the memory's contributorNote stays the shared story
  approxDateText   String?                  // per-file "roughly when" (max 120), independent of the memory's
  place            String?                  // per-file "where" (max 200), independent of the memory's
  latitude         Float?                   // WGS 84 from the original's EXIF; never shown on the site; read through /api/mcp; a non-null pair (or no decision yet) keeps a video or MP4-family recording off See memories (plan 2026-11-08 D16) (CHECKs Media_coordinates_pair, Media_latitude_range)
  longitude        Float?                   // WGS 84 from the original's EXIF; never shown on the site; read through /api/mcp; a non-null pair (or no decision yet) keeps a video or MP4-family recording off See memories (plan 2026-11-08 D16) (CHECKs Media_coordinates_pair, Media_longitude_range)
  gpsCheckedAt     DateTime?                // found or absent decided; null = not yet (CHECK Media_coordinates_checked: coordinates only with this stamp)
  gpsAttempts      Int         @default(0)  // GPS reads claimed; extraction stops after 3 while gpsCheckedAt is still null
  gpsClaimedAt     DateTime?                // the GPS read's lease: set with each claimed attempt, cleared by the decision (and by purge); older than GPS_STALE_CLAIM_MS = abandoned
  deletedAt        DateTime?                // soft delete: removed file, cancelled reservation or cancelled replacement; blobs purged by cron step (f)
  purgedAt         DateTime?                // set by cron step (f) before any byte is deleted; once set the removal completes even if the memory is restored; READY rows flip to FAILED at the same time
  replacesMediaId  String?                  // set on a PENDING replacement; the target is retired when this row reaches READY (one-to-many so a FAILED attempt can be retried)
  reservedUntil    DateTime?                // while PENDING: holds the byte budget and may still receive bytes until this moment (creation or last ticket + UPLOAD_WINDOW_MS); cron (a)/(f2) and the budget read it; null only on rows the old code wrote (issue #44)
  sortOrder        Int         @default(0)  // display order chosen by the contributor; a replacement copies its target's
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  memory           Memory      @relation(fields: [memoryId], references: [id])
  replaces         Media?      @relation("Replacement", fields: [replacesMediaId], references: [id])
  replacements     Media[]     @relation("Replacement")
  derivatives      DerivedMedia[]
  @@index([memoryId])
  @@index([memoryId, deletedAt])
  @@index([replacesMediaId])
  @@index([checksumSha256])
  @@index([status, createdAt])
  @@index([status, reservedUntil])
  @@index([createdAt])
}

/// Server-made copies of an original (web copy, email thumbnail, later poster).
/// One row per kind per media; a row exists from the moment a worker claims the
/// work, with its candidate blob pathname, so a lost race or a crash never
/// leaves an untracked blob. Rows are caches: purge deletes them with the blob.
model DerivedMedia {
  id         String        @id @default(uuid())
  mediaId    String
  kind       DerivedKind
  status     DerivedStatus @default(PENDING)
  storageKey String        @unique      // <env derived prefix><memoryId>/<uuid>.<ext>; the blob exists only once READY
  mimeType   String?                    // image/jpeg | image/png | image/webp | image/gif
  sizeBytes  Int?
  width      Int?
  height     Int?
  error      String?                    // see DerivedStatus.FAILED
  attempts   Int           @default(0)
  claimedAt  DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  media      Media         @relation(fields: [mediaId], references: [id])
  @@unique([mediaId, kind])
  @@index([status, updatedAt])
}

/// Bytes served per UTC day, per scope (`global` or `media:<id>`): the egress
/// allowance behind /api/media (issue #45, features/media/egress.ts). Rows are
/// counters written by one conditional upsert each; nothing else reads them.
model EgressCounter {
  scope     String
  day       DateTime @db.Date
  bytes     BigInt   @default(0)
  updatedAt DateTime @default(now())
  @@id([scope, day])
  @@index([day])
}

/// Reverse-geocode cache: one row per provider and point, keyed in degrees × 1e6
/// (rounded). `result` is the trimmed response only (name, category, type,
/// addresstype, the matched place's own lat/lon, and address city, town,
/// village, hamlet, county, state, country, country_code); never house_number,
/// road or postcode. SQL NULL (`Prisma.DbNull`) means the provider had no
/// result; no row means not looked up yet.
model PlaceLookup {
  provider  String
  latE6     Int
  lonE6     Int
  result    Json?
  fetchedAt DateTime @default(now())
  @@id([provider, latE6, lonE6])
}

/// Site-wide lease and fence per provider: a caller claims the lease, sends at
/// once, then fences `nextAllowedAt` = DB now() + 1.1 s and clears the lease. A
/// lease left by a dead holder expires at `leaseUntil` (claim + 10 s).
model PlaceLookupThrottle {
  provider      String    @id
  nextAllowedAt DateTime  @db.Timestamptz(3) // compared with the database's now() by the claim and fence SQL, so time-zone aware
  leaseToken    String?
  leaseUntil    DateTime? @db.Timestamptz(3)
}

model Person {
  id                     String   @id @default(uuid())
  memorialId             String
  name                   String
  relationshipToDeceased String?
  isTheDeceased          Boolean  @default(false)
  createdAt              DateTime @default(now())
  memorial               Memorial @relation(fields: [memorialId], references: [id])
  @@unique([memorialId, name])
}

model MemoryRevision {
  id              String     @id @default(uuid())
  memoryId        String
  changedByUserId String?
  changedVia      ChangedVia
  before          Json
  after           Json
  createdAt       DateTime   @default(now())
  memory          Memory     @relation(fields: [memoryId], references: [id])
  changedBy       User?      @relation(fields: [changedByUserId], references: [id])
  @@index([memoryId])
}

model WebhookEvent {                        // raw audit; insert first, process after [C28]
  id          String    @id @default(uuid())
  provider    String    // "vercel-blob"
  kind        String    // "upload_completed"
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  error       String?
  @@index([processedAt, receivedAt])
}

model EmailLog {                            // mirrors EmpathIQ, keyed per memory and type [C8]
  id                String      @id @default(uuid())
  memoryId          String
  recipientEmail    String                   // one address, or the attempted admin recipients joined with ", " (ADMIN_NEW_MEMORY)
  recipientKey      String?                  // canonical form of recipientEmail for the per-recipient cap (+tag and Gmail dots folded; issue #46); null only on rows older than the column
  emailType         EmailType
  status            EmailStatus @default(PENDING)
  sendgridMessageId String?     @unique
  errorMessage      String?
  attempts          Int         @default(0)
  nextAttemptAt     DateTime?                // set by the cron for retries
  sentAt            DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  memory            Memory      @relation(fields: [memoryId], references: [id])
  @@unique([memoryId, emailType])          // confirmation idempotency by constraint
  @@index([status, nextAttemptAt])
  @@index([recipientEmail, createdAt])     // per-recipient cap (pre-#46 key; kept for the audit view)
  @@index([recipientKey, updatedAt])       // per-recipient cap, counted by the canonical key and the last state change
  @@index([emailType, status, updatedAt])  // global outbound ceilings and the admin hourly cap
}
