{
  "name": "jowray_com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:offline": "NODE_OPTIONS=--import=./scripts/no-network.mjs NEXT_TELEMETRY_DISABLED=1 CHECKPOINT_DISABLE=1 npm run build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "type-check": "next typegen && tsc --noEmit",
    "validate": "npm run type-check && npm run lint",
    "test": "vitest",
    "test:run": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@neondatabase/serverless": "1.2.0",
    "@next/env": "^16.4.4",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/nextjs": "^11.10.0",
    "@vercel/blob": "^2.8.2",
    "fix-webm-duration": "1.0.6",
    "heic-decode": "^2.1.0",
    "next": "16.4.4",
    "pino": "^10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-zoom-pan-pinch": "4.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "mermaid": "12.2.0",
    "pino-pretty": "^13.2.0",
    "playwright-core": "1.64.1",
    "prisma": "^7.10.1",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
